---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { Article } from '../lib/types';

export interface Props {
  article: Article;
  relatedArticles: Article[];
}

const { article, relatedArticles } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(article.publishedAt));
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  image={article.featuredImage}
  articleDate={article.publishedAt}
  authorName={article.author.name}
  type="article"
>
  <article class="py-8 sm:py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb & Back Navigation -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-500 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-stone-900 transition-colors">Blog</a>
        <span>/</span>
        <a href={`/category/${article.category.slug}`} class="text-indigo-600 hover:text-indigo-800 transition-colors">
          {article.category.name}
        </a>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 text-center sm:text-left">
        <!-- Category Pill & Reading Time -->
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5 text-xs font-semibold text-stone-500 mb-4">
          <a
            href={`/category/${article.category.slug}`}
            class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-colors uppercase tracking-wider text-[11px]"
          >
            {article.category.name}
          </a>
          <span>•</span>
          <time datetime={article.publishedAt}>{formattedDate}</time>
          <span>•</span>
          <span>{article.readingTime} min read</span>
        </div>

        <!-- Headline -->
        <h1 class="font-editorial-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 tracking-tight leading-[1.15] mb-6">
          {article.title}
        </h1>

        <!-- Subtitle / Excerpt -->
        {article.subtitle && (
          <p class="font-editorial-serif italic text-lg sm:text-xl text-stone-600 leading-relaxed max-w-3xl">
            {article.subtitle}
          </p>
        )}

        <!-- Author Byline Bar -->
        <div class="mt-8 pt-6 border-t border-b border-stone-200 flex flex-wrap items-center justify-between gap-4 py-4">
          <div class="flex items-center gap-3">
            <img
              src={article.author.avatar}
              alt={article.author.name}
              class="w-12 h-12 rounded-full border border-stone-200 shadow-xs"
              loading="eager"
            />
            <div>
              <div class="text-sm font-bold text-stone-900">{article.author.name}</div>
              <div class="text-xs text-stone-500">{article.author.role}</div>
            </div>
          </div>

          <!-- Share / Mode Indicator -->
          <div class="flex flex-wrap items-center gap-2 text-xs text-stone-500">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-stone-100 text-stone-600 font-mono text-[11px]">
              ID #{article.id}
            </span>
            {article.proEndpointRoute && (
              <span
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono text-[11px]"
                title={`Resolved via RKX API Studio Pro Dynamic Route: ${article.proEndpointRoute}`}
              >
                Pro Dynamic Route
              </span>
            )}
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-stone-100 text-stone-600 font-mono text-[11px]">
              Static Pre-rendered
            </span>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      <figure class="mb-12 rounded-2xl overflow-hidden border border-stone-200 shadow-sm bg-stone-900">
        <img
          src={article.featuredImage}
          alt={article.featuredImageAlt || article.title}
          class="w-full aspect-16/9 object-cover"
          loading="eager"
        />
        {article.featuredImageAlt && (
          <figcaption class="p-3 text-center text-xs text-stone-500 bg-stone-50 border-t border-stone-100">
            {article.featuredImageAlt}
          </figcaption>
        )}
      </figure>

      <!-- Article Body (Rich editorial HTML) -->
      <div class="article-prose" set:html={article.content} />

      <!-- Tags & Meta Footer -->
      {article.tags && article.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-stone-200">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-stone-400 mr-2">Tags:</span>
            {article.tags.map((tag) => (
              <span class="px-2.5 py-1 rounded-md bg-stone-100 text-xs font-medium text-stone-700">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Pro ACF Related Resources Callout (Rendered only when Pro ACF data is available) -->
      {article.relatedResources && article.relatedResources.length > 0 && (
        <div class="mt-10 p-5 sm:p-6 bg-indigo-50/50 border border-indigo-200/80 rounded-2xl">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-700">
              ACF Curated Reading Path
            </span>
            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-mono text-[10px] font-semibold">
              acf:related_resources
            </span>
          </div>
          <ul class="space-y-2">
            {article.relatedResources.map((res) => (
              <li>
                <a
                  href={`/blog/${res.slug}`}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 hover:text-indigo-700 transition-colors"
                >
                  <span class="text-indigo-500">→</span>
                  <span>{res.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Author Bio Box -->
      <div class="mt-12 p-6 sm:p-8 bg-stone-100/70 border border-stone-200 rounded-2xl flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <img
          src={article.author.avatar}
          alt={article.author.name}
          class="w-16 h-16 rounded-full border border-stone-300 shadow-xs shrink-0"
          loading="lazy"
        />
        <div class="space-y-2 text-center sm:text-left">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
            <h3 class="text-base font-bold text-stone-900">Written by {article.author.name}</h3>
            {article.author.github && (
              <a
                href={article.author.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[11px] font-semibold text-indigo-700 hover:text-indigo-900 underline"
              >
                GitHub Profile
              </a>
            )}
          </div>
          <p class="text-xs font-medium text-indigo-700">{article.author.role}</p>
          <p class="text-sm text-stone-600 leading-relaxed">
            {article.author.bio || 'Staff writer and technical researcher at The Headless Journal.'}
          </p>
        </div>
      </div>

      <!-- Back to Articles Button -->
      <div class="mt-10 text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-stone-800 bg-white border border-stone-300 hover:bg-stone-50 hover:border-stone-400 transition-colors shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to All Articles</span>
        </a>
      </div>
    </div>

    <!-- Related Articles Section -->
    {relatedArticles && relatedArticles.length > 0 && (
      <section class="mt-16 sm:mt-24 pt-12 sm:pt-16 border-t border-stone-200 bg-stone-50/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-baseline justify-between mb-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-indigo-700">Recommended Reading</span>
              <h2 class="font-editorial-serif text-2xl sm:text-3xl font-extrabold text-stone-900 mt-1">
                Related Articles
              </h2>
            </div>
            <a href="/blog" class="text-xs font-bold text-stone-600 hover:text-indigo-600 transition-colors">
              Explore All →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {relatedArticles.map((rel) => (
              <ArticleCard article={rel} dense />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

