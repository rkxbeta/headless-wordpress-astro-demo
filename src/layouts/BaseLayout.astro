---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  authorName?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
}

const {
  title = 'The Headless Journal — Modern publishing, powered by WordPress and Astro',
  description = 'An open-source showcase demonstrating how decoupled WordPress and Astro deliver sub-100ms content delivery with zero runtime JavaScript.',
  image = '/images/og-default.svg',
  articleDate,
  authorName,
  type = 'website',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteName = 'The Headless Journal';
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const fullImageUrl = new URL(image, Astro.site || Astro.url.origin).href;
const fullCanonicalUrl = canonicalUrl;

// JSON-LD Structured Data
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description: description,
      image: fullImageUrl,
      datePublished: articleDate,
      author: {
        '@type': 'Person',
        name: authorName || 'The Headless Journal Staff',
      },
      publisher: {
        '@type': 'Organization',
        name: siteName,
        url: Astro.site?.toString() || 'https://demo.headless-journal.local',
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      description: description,
      url: Astro.site?.toString() || 'https://demo.headless-journal.local',
    };
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullCanonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- RSS & Sitemap Discovery -->
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex flex-col min-h-screen bg-[#faf9f6] text-stone-900 selection:bg-indigo-100 selection:text-indigo-900">
    <Header currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

