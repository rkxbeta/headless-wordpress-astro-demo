---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getFeaturedArticle, getLatestArticles, getCategories } from '../lib/content';

const featured = await getFeaturedArticle();
const latestArticles = await getLatestArticles(6, featured?.slug);
const categories = await getCategories();
---

<BaseLayout
  title="The Headless Journal — Modern publishing, powered by WordPress and Astro"
  description="An editorial engineering publication showcasing decoupled WordPress architectures, Astro static compilation, and clean API design."
>
  <div class="space-y-12 sm:space-y-16 lg:space-y-20 py-8 sm:py-12">
    <!-- Editorial Hero / Introduction -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-stone-200 pb-8 sm:pb-12">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-800 mb-4 border border-stone-200">
            <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
            <span>Editorial Engineering Showcase</span>
          </div>
          <h1 class="font-editorial-serif text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-stone-900 leading-[1.1]">
            Engineering the Next Generation of Content Publishing.
          </h1>
          <p class="mt-4 text-base sm:text-xl text-stone-600 font-editorial-serif leading-relaxed">
            Explorations in headless content management, zero-runtime JavaScript static generation,
            and lean API contracts between WordPress and Astro.
          </p>
        </div>

        <!-- Quick Category Bar -->
        <div class="mt-8 pt-6 border-t border-stone-100 flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="text-xs font-bold uppercase tracking-wider text-stone-600 mr-1">Topics:</span>
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1 rounded-full text-xs font-semibold bg-white border border-stone-200 text-stone-700 hover:border-indigo-600 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors shadow-2xs"
            >
              {cat.name}
              {cat.count !== undefined && <span class="text-stone-500 ml-1">({cat.count})</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Article Section -->
    {featured && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-amber-500 rounded-full"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-stone-900">Lead Editorial</span>
          </div>
          <span class="text-xs font-medium text-stone-600">Editor's Selection</span>
        </div>

        <FeaturedArticle article={featured} />
      </section>
    )}

    <!-- Latest Articles Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between border-b border-stone-200 pb-4 mb-8 gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-700">Chronicle</span>
          <h2 class="font-editorial-serif text-2xl sm:text-3xl font-extrabold text-stone-900 mt-1">
            Latest Dispatches
          </h2>
        </div>
        <a
          href="/blog"
          class="text-xs font-bold text-stone-700 hover:text-indigo-600 inline-flex items-center gap-1 transition-colors"
        >
          <span>Browse Complete Archive ({latestArticles.length + (featured ? 1 : 0)} articles)</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {latestArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>

    <!-- Architectural Highlights / Callout Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-stone-900 text-stone-100 rounded-3xl p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-lg border border-stone-800">
        <!-- Background accents -->
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-3xl relative z-10 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-stone-200 border border-white/15">
            <span>Decoupled Publishing Stack</span>
          </div>

          <h2 class="font-editorial-serif text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            How The Headless Journal Bridges WordPress &amp; Astro
          </h2>

          <p class="text-stone-300 text-sm sm:text-base leading-relaxed">
            WordPress provides the ultimate editorial workflow for authors, while Astro transforms
            raw REST content payloads into lightweight static assets. RKX API Studio acts as the
            high-throughput contract engine that optimizes JSON payloads, applies smart caching, and
            delivers near-instant edge content delivery.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-indigo-400">0 KB</div>
              <div class="text-xs text-stone-400 mt-1">Runtime Client JS</div>
            </div>
            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-emerald-400">100 / 100</div>
              <div class="text-xs text-stone-400 mt-1">Lighthouse Performance</div>
            </div>
            <div class="p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-amber-400">3 Modes</div>
              <div class="text-xs text-stone-400 mt-1">Demo, Free &amp; Pro Ready</div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap gap-4">
            <a
              href="/about"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold bg-white text-stone-900 hover:bg-stone-100 transition-colors shadow-sm"
            >
              <span>Explore The Architecture</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="https://github.com/rkxbeta/headless-wordpress-astro-demo"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/15 transition-colors"
            >
              <span>GitHub Repository</span>
              <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

