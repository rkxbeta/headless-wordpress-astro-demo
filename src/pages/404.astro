---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | The Headless Journal"
  description="The requested page could not be found."
>
  <div class="py-16 sm:py-24 lg:py-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-700 border border-stone-200">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span>Error 404 • Not Found</span>
      </div>

      <h1 class="font-editorial-serif text-4xl sm:text-5xl font-extrabold text-stone-900 tracking-tight">
        Article or Page Not Found
      </h1>

      <p class="font-editorial-serif italic text-base sm:text-lg text-stone-600 leading-relaxed max-w-lg mx-auto">
        The dispatch or route you are looking for has been archived, moved, or does not exist in this edition.
      </p>

      <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-stone-900 text-white hover:bg-stone-800 transition-colors shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Return to Front Page</span>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-stone-700 bg-white border border-stone-300 hover:bg-stone-50 transition-colors shadow-xs"
        >
          <span>Browse Chronicle</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
