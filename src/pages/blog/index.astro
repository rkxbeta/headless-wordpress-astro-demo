---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getArticles, getCategories } from '../../lib/content';

const pageSize = 4;
const pagination = await getArticles({ page: 1, pageSize });
const categories = await getCategories();
---

<BaseLayout
  title="All Articles — The Headless Journal"
  description="Explore technical articles, guides, and engineering patterns on headless WordPress, Astro static generation, and high-performance API design."
>
  <div class="py-8 sm:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      <!-- Archive Header -->
      <div class="border-b border-stone-200 pb-8">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-700">Publication Index</span>
          <h1 class="font-editorial-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 tracking-tight mt-2">
            All Articles &amp; Dispatches
          </h1>
          <p class="font-editorial-serif italic text-base sm:text-lg text-stone-600 mt-3">
            In-depth guides covering headless WordPress architecture, Astro static compilation, and high-performance API design.
          </p>
        </div>

        <!-- Category Filters -->
        <div class="mt-8 pt-6 border-t border-stone-100 flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-stone-400 mr-2">Filter by Topic:</span>
          <a
            href="/blog"
            class="px-3 py-1 rounded-full text-xs font-semibold bg-stone-900 text-white shadow-xs"
            aria-current="page"
          >
            All Topics ({pagination.total})
          </a>
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1 rounded-full text-xs font-semibold bg-white border border-stone-200 text-stone-700 hover:border-stone-400 hover:bg-stone-50 transition-colors"
            >
              {cat.name} ({cat.count})
            </a>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {pagination.items.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>

      <!-- Pagination Component -->
      <Pagination
        page={pagination.page}
        totalPages={pagination.totalPages}
        hasPrev={pagination.hasPrev}
        hasNext={pagination.hasNext}
        prevUrl={pagination.prevUrl}
        nextUrl={pagination.nextUrl}
        basePath="/blog"
      />
    </div>
  </div>
</BaseLayout>

