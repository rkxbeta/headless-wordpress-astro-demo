---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAllArticles, getArticleBySlug, getRelatedArticles } from '../../lib/content';
import type { Article } from '../../lib/types';

export async function getStaticPaths() {
  const articles = await getAllArticles();

  const paths = await Promise.all(
    articles.map(async (summary) => {
      const article = (await getArticleBySlug(summary.slug)) ?? summary;
      const related = await getRelatedArticles(article.slug, article.category.slug, 3);
      return {
        params: { slug: article.slug },
        props: { article, relatedArticles: related },
      };
    })
  );

  return paths;
}

interface Props {
  article: Article;
  relatedArticles: Article[];
}

const { article, relatedArticles } = Astro.props;
---

<ArticleLayout article={article} relatedArticles={relatedArticles} />

