---
import { getContentMode } from '../lib/content';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const mode = getContentMode();

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'All Articles', href: '/blog' },
  { label: 'Architecture', href: '/category/headless-architecture' },
  { label: 'Astro', href: '/category/astro-engineering' },
  { label: 'API Design', href: '/category/api-design' },
  { label: 'WordPress', href: '/category/wordpress-backend' },
  { label: 'About', href: '/about' },
];

const todayFormatted = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());
---

<header class="border-b border-stone-200 bg-white/95 backdrop-blur-sm sticky top-0 z-40 transition-colors">
  <!-- Editorial Top Bar -->
  <div class="border-b border-stone-100 bg-stone-50/80 text-xs text-stone-600 px-4 py-1.5">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <span class="font-medium text-stone-700">{todayFormatted}</span>
        <span class="text-stone-300">|</span>
        <span class="hidden sm:inline text-stone-500">Vol. I • Open Source Showcase</span>
      </div>

      <div class="flex items-center gap-3">
        <!-- Content Mode Pill -->
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Mode: <span class="uppercase tracking-wider">{mode}</span>
        </span>
        <span class="hidden md:inline text-stone-400 text-[11px]">
          {mode === 'pro'
            ? 'RKX API Studio Pro (Dynamic Routes + ACF)'
            : mode === 'free'
              ? 'RKX API Studio Free'
              : 'Local Content Provider'}
        </span>
      </div>
    </div>
  </div>

  <!-- Masthead -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <a href="/" class="group inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 rounded">
          <span class="block text-xs uppercase tracking-[0.25em] text-indigo-700 font-bold mb-1">An Editorial Engineering Publication</span>
          <h1 class="font-editorial-serif text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-stone-900 group-hover:text-indigo-950 transition-colors">
            The Headless Journal
          </h1>
        </a>
        <p class="font-editorial-serif italic text-stone-600 text-sm sm:text-base mt-1">
          Modern publishing, powered by WordPress and Astro.
        </p>
      </div>

      <!-- Quick Action / Docs CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="/about"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-xs font-semibold text-stone-700 bg-stone-100 hover:bg-stone-200 transition-colors"
        >
          <span>Architecture &amp; Specs</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="https://github.com/rkxbeta/headless-wordpress-astro-demo"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-xs font-semibold text-stone-700 bg-stone-100 hover:bg-stone-200 transition-colors"
        >
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="mt-6 pt-4 border-t border-stone-200" aria-label="Main Navigation">
      <div class="flex items-center justify-between overflow-x-auto pb-1 scrollbar-none">
        <ul class="flex items-center gap-1 sm:gap-2 text-sm font-medium text-stone-700 whitespace-nowrap">
          {navItems.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'px-3 py-1.5 rounded-md transition-colors inline-block',
                    isActive
                      ? 'bg-stone-900 text-white font-semibold shadow-xs'
                      : 'hover:bg-stone-100 text-stone-700 hover:text-stone-900',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="hidden sm:flex items-center pl-4 border-l border-stone-200 ml-4">
          <a
            href="/rss.xml"
            class="text-xs font-semibold text-stone-500 hover:text-amber-700 inline-flex items-center gap-1 transition-colors"
            title="Subscribe via RSS"
          >
            <svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
            </svg>
            <span>RSS</span>
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

