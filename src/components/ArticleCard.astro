---
import type { Article } from '../lib/types';

interface Props {
  article: Article;
  dense?: boolean;
}

const { article, dense = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(article.publishedAt));
---

<article class="group flex flex-col bg-white border border-stone-200 rounded-xl overflow-hidden hover:border-stone-300 hover:shadow-md transition-all duration-300">
  <!-- Card Image -->
  <div class="relative overflow-hidden bg-stone-900 aspect-16/9">
    <a href={`/blog/${article.slug}`} tabindex="-1" aria-hidden="true" class="block w-full h-full">
      <img
        src={article.featuredImage}
        alt={article.featuredImageAlt || article.title}
        class="w-full h-full object-cover object-center group-hover:scale-103 transition-transform duration-500 ease-out"
        loading="lazy"
      />
    </a>
    <div class="absolute top-3 left-3">
      <a
        href={`/category/${article.category.slug}`}
        class="px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase bg-stone-900/85 text-white backdrop-blur-xs hover:bg-indigo-600 transition-colors"
      >
        {article.category.name}
      </a>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta: Date & Reading Time -->
      <div class="flex items-center gap-2 text-xs text-stone-500 mb-2.5 font-medium">
        <time datetime={article.publishedAt}>{formattedDate}</time>
        <span>•</span>
        <span>{article.readingTime} min read</span>
      </div>

      <!-- Title -->
      <h3 class:list={[
        "font-editorial-serif font-bold text-stone-900 group-hover:text-indigo-900 transition-colors tracking-tight",
        dense ? "text-lg sm:text-xl line-clamp-2" : "text-xl sm:text-2xl line-clamp-2"
      ]}>
        <a href={`/blog/${article.slug}`}>
          {article.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="mt-3 text-stone-600 text-sm leading-relaxed line-clamp-3">
        {article.excerpt}
      </p>
    </div>

    <!-- Author & Footer -->
    <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <img
          src={article.author.avatar}
          alt={article.author.name}
          class="w-7 h-7 rounded-full bg-stone-100 border border-stone-200"
          loading="lazy"
        />
        <span class="text-xs font-semibold text-stone-700">{article.author.name}</span>
      </div>

      <a
        href={`/blog/${article.slug}`}
        class="text-xs font-bold text-indigo-600 group-hover:text-indigo-800 inline-flex items-center gap-1 transition-colors"
        aria-label={`Read article: ${article.title}`}
      >
        <span>Read</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>

