---
import { getContentMode } from '../lib/content';

const currentYear = new Date().getFullYear();
const mode = getContentMode();
---

<footer class="mt-auto border-t border-stone-200 bg-white text-stone-600">
  <!-- Upper Editorial Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Masthead Blurb -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-indigo-600 rounded-sm"></span>
          <span class="font-editorial-serif text-2xl font-bold tracking-tight text-stone-900">
            The Headless Journal
          </span>
        </div>
        <p class="font-editorial-serif italic text-stone-600 text-sm max-w-md">
          “Modern publishing, powered by WordPress and Astro.”
        </p>
        <p class="text-sm text-stone-500 leading-relaxed max-w-prose">
          An open-source technical showcase demonstrating how modern editorial engineering decouples
          WordPress content management into a lightning-fast, zero-runtime JavaScript Astro static frontend.
        </p>

        <!-- Mode Indicator Box -->
        <div class="p-3.5 bg-stone-50 rounded-lg border border-stone-200 text-xs text-stone-600 max-w-md space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-stone-800">Current Runtime State</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              {mode} mode active
            </span>
          </div>
          <p class="text-stone-500 text-[11px] leading-normal">
            {mode === 'pro'
              ? 'Content is served via RKX API Studio Pro (custom namespace rkx/v1, Dynamic Route Builder single-item endpoints, and typed ACF fields).'
              : mode === 'free'
                ? 'Content is served via RKX API Studio Free (/wp-json/rkx-api-studio/v1/posts, /categories, /featured).'
                : 'Content is served via the standalone local JSON adapter. Ready for RKX API Studio Free & Pro drop-in integration.'}
          </p>
        </div>
      </div>

      <!-- Col 2: Taxonomy Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-editorial-sans">
          Editorial Topics
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/category/headless-architecture" class="text-stone-600 hover:text-indigo-600 transition-colors">
              Headless Architecture
            </a>
          </li>
          <li>
            <a href="/category/astro-engineering" class="text-stone-600 hover:text-indigo-600 transition-colors">
              Astro Engineering
            </a>
          </li>
          <li>
            <a href="/category/api-design" class="text-stone-600 hover:text-indigo-600 transition-colors">
              API &amp; Performance
            </a>
          </li>
          <li>
            <a href="/category/wordpress-backend" class="text-stone-600 hover:text-indigo-600 transition-colors">
              WordPress &amp; CMS
            </a>
          </li>
          <li>
            <a href="/blog" class="text-stone-600 hover:text-indigo-600 font-medium transition-colors">
              → View All Articles
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources & Meta -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-stone-900 font-editorial-sans">
          Project &amp; Standards
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/about" class="text-stone-600 hover:text-indigo-600 transition-colors">
              About This Project
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-stone-600 hover:text-amber-700 transition-colors">
              RSS Feed (XML)
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="text-stone-600 hover:text-indigo-600 transition-colors">
              Sitemap Index
            </a>
          </li>
          <li>
            <a
              href="https://rkxbeta.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-600 hover:text-indigo-600 transition-colors inline-flex items-center gap-1"
            >
              <span>RKX API Studio</span>
              <svg class="w-3 h-3 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar with Exact Attribution Requirement -->
  <div class="border-t border-stone-200 bg-stone-50 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>
        &copy; {currentYear} The Headless Journal. Released under the MIT Open Source License.
      </p>

      <!-- Exact attribution requirement: Built with Astro and RKX API Studio -->
      <p class="font-medium text-stone-700">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-stone-900 hover:text-indigo-600 underline underline-offset-2">Astro</a> and <a href="https://rkxbeta.com" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:text-indigo-800 font-semibold underline underline-offset-2">RKX API Studio</a>.
      </p>
    </div>
  </div>
</footer>

