---
import type { Article } from '../lib/types';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(article.publishedAt));
---

<article class="group relative bg-white border border-stone-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
    <!-- Featured Image (7 cols on desktop) -->
    <div class="lg:col-span-7 relative overflow-hidden bg-stone-900 aspect-16/9 lg:aspect-auto">
      <a href={`/blog/${article.slug}`} tabindex="-1" aria-hidden="true" class="block w-full h-full">
        <img
          src={article.featuredImage}
          alt={article.featuredImageAlt || article.title}
          class="w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-500 ease-out"
          loading="eager"
        />
      </a>
      <div class="absolute top-4 left-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-stone-900/90 text-white backdrop-blur-md border border-white/10 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Featured Story
        </span>
      </div>
    </div>

    <!-- Editorial Story Body (5 cols on desktop) -->
    <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
      <div>
        <!-- Category & Reading Time -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-stone-500 mb-4">
          <a
            href={`/category/${article.category.slug}`}
            class="px-2.5 py-1 rounded-md bg-stone-100 text-stone-800 hover:bg-stone-200 hover:text-indigo-600 transition-colors"
          >
            {article.category.name}
          </a>
          <span>•</span>
          <time datetime={article.publishedAt}>{formattedDate}</time>
          <span>•</span>
          <span>{article.readingTime} min read</span>
        </div>

        <!-- Title -->
        <h2 class="font-editorial-serif text-2xl sm:text-3xl lg:text-4xl font-extrabold text-stone-900 tracking-tight leading-tight group-hover:text-indigo-900 transition-colors">
          <a href={`/blog/${article.slug}`}>
            {article.title}
          </a>
        </h2>

        <!-- Excerpt -->
        <p class="mt-4 text-stone-600 text-sm sm:text-base leading-relaxed line-clamp-3">
          {article.excerpt}
        </p>
      </div>

      <!-- Author Byline & CTA -->
      <div class="mt-8 pt-6 border-t border-stone-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img
            src={article.author.avatar}
            alt={article.author.name}
            class="w-10 h-10 rounded-full bg-stone-100 border border-stone-200"
            loading="lazy"
          />
          <div>
            <div class="text-xs font-bold text-stone-900">{article.author.name}</div>
            <div class="text-[11px] text-stone-500">{article.author.role}</div>
          </div>
        </div>

        <a
          href={`/blog/${article.slug}`}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 group-hover:text-indigo-800 transition-colors"
          aria-label={`Read Story: ${article.title}`}
        >
          <span>Read Story</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

