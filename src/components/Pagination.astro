---
interface Props {
  page: number;
  totalPages: number;
  hasPrev: boolean;
  hasNext: boolean;
  prevUrl?: string;
  nextUrl?: string;
  basePath?: string;
}

const {
  page,
  totalPages,
  hasPrev,
  hasNext,
  prevUrl,
  nextUrl,
  basePath = '/blog',
} = Astro.props;

if (totalPages <= 1) {
  // No pagination needed if only 1 page
  return;
}

// Generate an array of page numbers
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) return basePath;
  return `${basePath}/page/${pageNum}`;
}
---

<nav class="flex items-center justify-between border-t border-stone-200 px-4 py-6 sm:px-0" aria-label="Pagination">
  <!-- Previous Button -->
  <div class="flex flex-1">
    {hasPrev && prevUrl ? (
      <a
        href={prevUrl}
        class="inline-flex items-center gap-2 px-4 py-2 border border-stone-300 rounded-md text-xs sm:text-sm font-semibold text-stone-700 bg-white hover:bg-stone-50 transition-colors shadow-xs"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Previous</span>
      </a>
    ) : (
      <span class="inline-flex items-center gap-2 px-4 py-2 border border-stone-200 rounded-md text-xs sm:text-sm font-semibold text-stone-400 bg-stone-100 cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Previous</span>
      </span>
    )}
  </div>

  <!-- Page Numbers -->
  <div class="hidden md:flex items-center gap-1">
    {pages.map((p) => {
      const isCurrent = p === page;
      const url = getPageUrl(p);
      return isCurrent ? (
        <span
          class="inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-bold bg-stone-900 text-white shadow-xs"
          aria-current="page"
        >
          {p}
        </span>
      ) : (
        <a
          href={url}
          class="inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors"
        >
          {p}
        </a>
      );
    })}
  </div>

  <!-- Current Page Indicator (Mobile) -->
  <div class="md:hidden text-xs font-semibold text-stone-600">
    Page {page} of {totalPages}
  </div>

  <!-- Next Button -->
  <div class="flex flex-1 justify-end">
    {hasNext && nextUrl ? (
      <a
        href={nextUrl}
        class="inline-flex items-center gap-2 px-4 py-2 border border-stone-300 rounded-md text-xs sm:text-sm font-semibold text-stone-700 bg-white hover:bg-stone-50 transition-colors shadow-xs"
      >
        <span>Next</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-2 px-4 py-2 border border-stone-200 rounded-md text-xs sm:text-sm font-semibold text-stone-400 bg-stone-100 cursor-not-allowed">
        <span>Next</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    )}
  </div>
</nav>

