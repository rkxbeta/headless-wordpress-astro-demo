# The Headless Journal - Environment Configuration

# Content delivery mode:
# - demo: Local standalone JSON content (no WordPress or backend required)
# - free: WordPress + RKX API Studio Free 1.0.1
# - pro:  WordPress + RKX API Studio Pro 1.1.0 (Dynamic Route Builder, Custom Namespace, ACF)
CONTENT_MODE=demo

# Base site URL for canonical links, sitemaps, and Open Graph metadata
SITE_URL=https://demo.headless-journal.local

# WordPress API Base URL (Required when CONTENT_MODE=free or pro)
WORDPRESS_API_URL=http://localhost:8088

# Custom REST API Namespace for Pro Mode (Used when CONTENT_MODE=pro)
RKX_API_NAMESPACE=rkx/v1

# Optional API Key for protected RKX API Studio endpoints (sent server-side only)
# RKX_API_KEY=your-api-key-here

# Optional Public Media Base URL (leave unset to serve /wp-content/uploads/* from the same HTTPS origin)
# PUBLIC_MEDIA_BASE_URL=https://cdn.example.com

# Local Docker Compose WordPress Environment (for reproducible local development)
WORDPRESS_PORT=8088
WP_DB_NAME=rkx_headless_journal
WP_DB_USER=rkx_journal_user
WP_DB_PASSWORD=change_me_local_db_password
WP_DB_ROOT_PASSWORD=change_me_local_root_password
WP_TABLE_PREFIX=wp_
WP_DEBUG=0
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_local_admin_password
WP_ADMIN_EMAIL=editor@headless-journal.local
